#!/usr/bin/env bash
# ==============================================================================
# Omarchy File Picker - CLI and Launcher
# ==============================================================================

set -euo pipefail

# Resolve symlinks to find the real plugin directory
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )/.." >/dev/null 2>&1 && pwd )"

SCAN_SCRIPT="$SCRIPT_DIR/scan.sh"
CONFIG_FILE="${OMARCHY_FILE_PICKER_CONFIG:-$HOME/.config/omarchy/file-picker.json}"

print_help() {
  cat << 'USAGE'
Omarchy File Picker - Lightning-fast fuzzy file search & launcher

Usage:
  omarchy-file-picker [options]

Options:
  --tui, --fzf, -t  Open terminal interactive fuzzy picker with live previews (default)
  --overlay, -o     Toggle Omarchy GUI overlay
  --refresh, -r     Force re-index / refresh file cache
  --config, -c      Open configuration file in $EDITOR
  --category <cat>  Pre-filter by category (documents, notes, videos, audio, images, code)
  --help, -h        Show this help message

Keybindings in TUI mode:
  Enter             Open file in default application
  Alt+Enter         Open containing directory
  Ctrl+Y            Copy file path to clipboard
  Ctrl+R            Rebuild cache and refresh list

Configuration:
  Edit ~/.config/omarchy/file-picker.json to add custom folders, extensions, and exclusions.
USAGE
}

open_config() {
  if [[ ! -f "$CONFIG_FILE" && -f "$SCRIPT_DIR/default-config.json" ]]; then
    mkdir -p "$(dirname "$CONFIG_FILE")"
    cp "$SCRIPT_DIR/default-config.json" "$CONFIG_FILE"
  fi

  local editor="${EDITOR:-${VISUAL:-nvim}}"
  if command -v "$editor" >/dev/null 2>&1; then
    exec "$editor" "$CONFIG_FILE"
  elif command -v nano >/dev/null 2>&1; then
    exec nano "$CONFIG_FILE"
  else
    exec xdg-open "$CONFIG_FILE"
  fi
}

sanitize_category() {
  local cat="${1:-}"
  if [[ -n "$cat" ]]; then
    # Strictly allow only alphanumeric, underscore, hyphen
    if [[ ! "$cat" =~ ^[a-zA-Z0-9_-]+$ ]]; then
      echo "Error: Invalid category name '$cat'" >&2
      exit 1
    fi
  fi
  echo "$cat"
}

launch_tui() {
  local category
  category="$(sanitize_category "${1:-}")"

  local scan_args=("--tsv")
  if [[ -n "$category" ]]; then
    scan_args+=("--category" "$category")
  fi

  # Populate cache
  bash "$SCAN_SCRIPT" "${scan_args[@]}" >/dev/null 2>&1 || true

  # Export sanitized category for safe fzf reload without raw interpolation
  export OMARCHY_FP_CATEGORY="$category"
  export OMARCHY_FP_SCAN_SCRIPT="$SCAN_SCRIPT"

  local reload_cmd="bash \"\$OMARCHY_FP_SCAN_SCRIPT\" --force --tsv \${OMARCHY_FP_CATEGORY:+--category \"\$OMARCHY_FP_CATEGORY\"} | cut -f1"

  # Feed only file paths to fzf
  local selected
  selected=$(bash "$SCAN_SCRIPT" "${scan_args[@]}" | cut -f1 | fzf \
    --prompt "› " \
    --border rounded \
    --color "bg:#1c1c1c,fg:#d4d4d4,hl:#7aa2f7,hl+:#7aa2f7,bg+:#313131,fg+:#ffffff,border:#505050,prompt:#7aa2f7,pointer:#7aa2f7,info:#9ece6a" \
    --preview '
        f={}
        case "$f" in
            *.pdf)
                pdftotext "$f" - 2>/dev/null | head -40 ;;
            *.png|*.jpg|*.jpeg|*.webp|*.gif|*.svg|*.bmp|*.avif|*.ico|*.tiff)
                if command -v chafa >/dev/null 2>&1; then
                    chafa --size 60x15 "$f" 2>/dev/null
                fi
                file "$f" 2>/dev/null
                stat -c "Size: %s bytes | Modified: %y" "$f" 2>/dev/null ;;
            *.mp4|*.mkv|*.avi|*.mov|*.webm|*.flv|*.wmv|*.3gp)
                thumb="/tmp/fzf-thumb-$$.jpg"
                if command -v ffmpegthumbnailer >/dev/null 2>&1; then
                    ffmpegthumbnailer -i "$f" -o "$thumb" -s 512 -q 8 2>/dev/null
                    if command -v chafa >/dev/null 2>&1 && [ -f "$thumb" ]; then
                        chafa --size 60x15 "$thumb" 2>/dev/null
                    fi
                    rm -f "$thumb" 2>/dev/null
                fi
                echo "🎬 $(basename "$f")"
                ffprobe -v quiet -show_entries format=duration,size,bit_rate \
                    -of default=noprint_wrappers=1 "$f" 2>/dev/null ;;
            *.mp3|*.flac|*.ogg|*.wav|*.m4a|*.aac|*.opus)
                echo "🎵 $(basename "$f")"
                ffprobe -v quiet -show_entries format_tags=artist,title,album \
                    -of default=noprint_wrappers=1 "$f" 2>/dev/null ;;
            *.md|*.txt|*.org|*.rst|*.adoc)
                if command -v bat >/dev/null 2>&1; then
                    bat --style=plain --color=always --line-range :40 "$f" 2>/dev/null
                else
                    head -40 "$f"
                fi ;;
            *.py|*.rs|*.go|*.js|*.ts|*.jsx|*.tsx|*.c|*.cpp|*.h|*.hpp|*.sh|*.lua|*.json|*.toml|*.yaml|*.yml)
                if command -v bat >/dev/null 2>&1; then
                    bat --style=numbers --color=always --line-range :40 "$f" 2>/dev/null
                else
                    head -40 "$f"
                fi ;;
            *)
                file "$f" ;;
        esac
    ' \
    --preview-window=down:14:wrap \
    --height=100% \
    --layout=reverse \
    --info=inline \
    --bind "ctrl-r:reload($reload_cmd)" \
    --bind "alt-enter:execute(xdg-open \$(dirname {}) &)+abort" \
    --bind "ctrl-y:execute(echo -n {} | wl-copy)+abort" \
    --header "Enter: Open | Alt+Enter: Folder | Ctrl+Y: Copy | Ctrl+R: Refresh" \
  || true)

  [[ -z "$selected" ]] && exit 0

  if [[ -e "$selected" ]]; then
    setsid xdg-open "$selected" &>/dev/null &
    sleep 1
  fi
}

toggle_overlay() {
  local category
  category="$(sanitize_category "${1:-all}")"
  local payload="{\"category\":\"$category\"}"

  if command -v omarchy-shell >/dev/null 2>&1; then
    if omarchy-shell shell toggle arh.file-picker "$payload" 2>/dev/null; then
      exit 0
    fi
  fi

  launch_tui "$category"
}

# ------------------------------------------------------------- CLI Dispatch
MODE="tui"
TARGET_CATEGORY=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --overlay|-o)
      MODE="overlay"
      shift
      ;;
    --tui|--fzf|-t)
      MODE="tui"
      shift
      ;;
    --refresh|-r)
      echo "Re-indexing files..."
      bash "$SCAN_SCRIPT" --force >/dev/null
      echo "Cache refreshed successfully."
      exit 0
      ;;
    --config|-c)
      open_config
      exit 0
      ;;
    --category)
      TARGET_CATEGORY="$(sanitize_category "$2")"
      shift 2
      ;;
    --help|-h)
      print_help
      exit 0
      ;;
    *)
      TARGET_CATEGORY="$(sanitize_category "$1")"
      shift
      ;;
  esac
done

case "$MODE" in
  overlay)
    toggle_overlay "$TARGET_CATEGORY"
    ;;
  tui)
    launch_tui "$TARGET_CATEGORY"
    ;;
esac
